}

/* ===== v4.2.7 Premium player consistency pass ===== */
:root{
  --player-gap:6px;
  --control-bg:rgba(10,12,16,.78);
  --control-border:color-mix(in srgb,var(--accent) 22%,rgba(255,255,255,.08));
}

/* Make every theme drive the same visual language — no stale red-only controls. */
.icon3d,.nav img,.top-icon img,.tiny3d img{
  filter:
    hue-rotate(var(--icon-hue,0deg))
    saturate(var(--icon-sat,1.35))
    brightness(var(--icon-bri,1))
    drop-shadow(0 2px 4px rgba(0,0,0,.55))
    drop-shadow(0 0 8px var(--glow,var(--glow))) !important;
}
.icon3d:hover,.nav:hover img,.top-icon:hover img,.tiny3d:hover{
  filter:
    hue-rotate(var(--icon-hue,0deg))
    saturate(1.45)
    brightness(1.06)
    drop-shadow(0 3px 5px rgba(0,0,0,.65))
    drop-shadow(0 0 10px var(--glow)) !important;
}

/* Platform-style player hierarchy: utility row → focal transport → timeline → controls. */
.player{
  border-color:color-mix(in srgb,var(--accent) 18%,#272a30);
  box-shadow:0 18px 42px rgba(0,0,0,.5),0 0 26px color-mix(in srgb,var(--accent) 7%,transparent);
}
.player-head{
  height:44px;
  padding:6px 10px;
  background:linear-gradient(180deg,rgba(17,19,24,.96),rgba(6,7,10,.96));
  border-bottom:1px solid rgba(255,255,255,.045);
}
.stream-left{gap:8px}
.live-tag{
  min-width:43px;
  justify-content:center;
  border-color:color-mix(in srgb,var(--accent) 70%,transparent) !important;
  color:var(--accent2) !important;
  background:color-mix(in srgb,var(--accent) 5%,transparent);
}
.stream-title{
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  color:#d9dbe0;
}
.player-actions{
  gap:2px;
  padding:2px;
  border:1px solid rgba(255,255,255,.055);
  border-radius:12px;
  background:rgba(0,0,0,.28);
}
.player-actions button{
  width:29px;height:29px;
  border-radius:9px !important;
}
.player-actions .svg-ico{width:15px;height:15px}

.video-wrap{
  height:188px;
  background:#000;
}
.visual{
  background:
    radial-gradient(ellipse at center,color-mix(in srgb,var(--accent) 11%,#050203) 0%,#050407 45%,#000 100%);
}
.transport{
  gap:8px;
  padding:7px 10px;
  border:1px solid rgba(255,255,255,.07);
  border-radius:22px;
  background:rgba(0,0,0,.40);
  box-shadow:0 10px 24px rgba(0,0,0,.34),inset 0 1px rgba(255,255,255,.035);
  backdrop-filter:blur(9px);
}
.round-control{
  width:38px;height:38px;
  border-color:color-mix(in srgb,var(--accent) 34%,transparent) !important;
  background:rgba(8,9,12,.82) !important;
  box-shadow:0 5px 13px rgba(0,0,0,.4),0 0 11px color-mix(in srgb,var(--accent) 10%,transparent);
}
.round-control.seek-control{
  width:40px;height:40px;
}
.round-control .svg-ico{width:17px;height:17px}
.round-control small{font-size:0}
.center-play{
  width:54px;height:54px;
  border-width:1.5px !important;
  background:linear-gradient(145deg,color-mix(in srgb,var(--accent) 16%,#08090c),rgba(0,0,0,.78)) !important;
}
.center-play .icon3d{
  width:34px;height:34px;
}
.floating-tools{
  right:9px;bottom:8px;
  gap:4px;
  padding:4px;
  border-color:color-mix(in srgb,var(--accent) 20%,transparent);
  background:rgba(3,4,6,.76);
}
.float-tool{
  min-width:29px;height:27px;
  padding:0 7px;
  border-color:color-mix(in srgb,var(--accent) 28%,transparent) !important;
  background:rgba(9,10,13,.92) !important;
}
.float-tool .svg-ico{width:15px;height:15px}
.float-tool b{font-size:7px}

/* Cleaner timeline: stronger active track and consistent accent. */
.timeline{
  height:34px;
  padding:0 10px;
  gap:7px;
  background:linear-gradient(180deg,#050608,#030405);
  border-top:1px solid rgba(255,255,255,.035);
  border-bottom:1px solid rgba(255,255,255,.035);
}
.timeline input[type=range]{
  --progress:0%;
  height:4px;
  background:linear-gradient(90deg,var(--accent) 0 var(--progress),#20242b var(--progress) 100%) !important;
}
.timeline input::-webkit-slider-thumb{
  width:10px;height:10px;
  background:var(--accent);
  border:2px solid #fff;
  box-shadow:0 0 8px var(--glow);
}

/* Bottom player controls: balanced touch targets and clear grouping. */
.controls{
  min-height:47px;
  padding:6px 9px 8px;
  background:#030405;
}
.control-left,.control-right{gap:5px}
.ctrl-btn{
  width:32px;height:32px;
  border-color:rgba(255,255,255,.07);
  background:rgba(255,255,255,.035);
}
.volume-wrap{gap:5px}
.volume-wrap input{width:58px !important}
.mini{
  height:30px;
  min-width:38px;
  border-color:rgba(255,255,255,.08);
  background:rgba(255,255,255,.035);
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:4px;
}
.mini-cc img{
  width:20px;height:20px;
}
.mini-cc .icon3d{
  width:20px;height:20px;
}

/* The play CTA uses the same 3D language as the rest of the app. */
.glass-play,.play-btn.glass-play{
  min-width:74px;
  justify-content:center;
  height:44px;
  border-radius:13px;
  border-color:color-mix(in srgb,var(--accent) 62%,transparent) !important;
  background:linear-gradient(145deg,
    color-mix(in srgb,var(--accent) 26%,transparent),
    color-mix(in srgb,var(--accent) 9%,#050608)) !important;
}
.glass-play .play-ico .icon3d{
  width:21px;height:21px;
}

/* Remove stale red literals from the interactive player surfaces. */
.copy,.mini,.ctrl-btn,.player-actions button,.float-tool,.round-control{
  transition:border-color .2s ease,background .2s ease,box-shadow .2s ease,transform .15s ease;
}
.copy:hover,.mini:hover,.ctrl-btn:hover,.player-actions button:hover{
  border-color:color-mix(in srgb,var(--accent) 32%,rgba(255,255,255,.08));
  background:color-mix(in srgb,var(--accent) 6%,rgba(255,255,255,.035));
}
.mini.active{
  border-color:var(--accent) !important;
  color:var(--accent2) !important;
  box-shadow:0 0 10px var(--glow) !important;
}

/* Small screens: preserve hierarchy without squeezing controls. */
@media(max-width:370px){
  .video-wrap{height:176px}
  .transport{gap:5px;padding:6px 7px}
  .round-control{width:35px;height:35px}
  .round-control.seek-control{width:36px;height:36px}
  .center-play{width:50px;height:50px}
  .floating-tools{right:6px;bottom:6px}
  .float-tool{min-width:26px;padding:0 6px}
  .volume-wrap input{width:45px !important}
}

/* ===== v4.2.7 Premium UI finalization ===== */
.sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}

