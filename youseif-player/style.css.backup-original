/* ===== FIX: Remove icon tilting / slanting (ميلان الأيقونات) ===== */
/* Keep subtle depth via drop-shadow only. No perspective/rotate that causes slant. */
.icon3d,
.nav img,
.top-icon > img,
.top-icon img,
.tiny3d,
.tiny3d img,
.icon-refresh,
.icon-sliders,
.icon-settings,
.icon-info,
.icon-cast,
.icon-fullscreen,
.icon-play,
.icon-pause,
.icon-volume,
.icon-lock,
.icon-cc,
.icon-search,
.icon-channels,
.icon-films,
.icon-downloads,
.icon-home,
.round-control img,
.center-play img,
.center-play .icon3d,
.player-actions img,
.ctrl-btn img {
  transform: none !important;
  transform-style: flat !important;
  perspective: none !important;
}

.icon3d:hover,
.nav:hover img,
.top-icon:hover > img,
.top-icon:hover img,
.tiny3d:hover,
.nav.active img {
  transform: translateY(-1px) scale(1.04) !important;
}

