/* Glass 3D system + live themes */
:root{--accent:#ff3042;--accent2:#ff6570;--glow:rgba(255,48,66,.22);--bg:#030304;--panel:#08090c;--glass:rgba(255,255,255,.055);--glass-line:rgba(255,255,255,.12)}
