.menu-glyph{width:25px;display:grid;gap:5px}.menu-glyph i{display:block;height:2px;border-radius:99px;background:linear-gradient(90deg,#fff,var(--accent2));box-shadow:0 0 8px var(--glow)}
.icon3d,.nav img,.top-icon>img,.tiny3d{filter:drop-shadow(0 3px 4px rgba(0,0,0,.72)) drop-shadow(0 0 7px var(--glow));}
.icon3d{border-radius:14px}
.nav{position:relative}.nav:before{content:"";position:absolute;inset:5px 10px 27px;border-radius:16px;background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.012));border:1px solid rgba(255,255,255,.055);opacity:0;transition:.2s;pointer-events:none}.nav.active:before{opacity:1;box-shadow:inset 0 1px rgba(255,255,255,.08),0 0 15px var(--glow)}
.bottom-nav{background:linear-gradient(145deg,rgba(18,18,23,.82),rgba(3,3,5,.88));border-color:color-mix(in srgb,var(--accent) 45%,#222 55%);box-shadow:0 -8px 28px rgba(0,0,0,.45),0 0 22px var(--glow);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.nav.active small{color:var(--accent2)}.nav.active:after{background:var(--accent)}
.theme-panel,.icon-vault{margin:12px 0;border:1px solid rgba(255,255,255,.10);border-radius:18px;background:linear-gradient(145deg,rgba(255,255,255,.065),rgba(255,255,255,.018));box-shadow:inset 0 1px rgba(255,255,255,.07),0 16px 30px rgba(0,0,0,.25);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);overflow:hidden}
.theme-panel-head,.vault-head{display:flex;align-items:center;justify-content:space-between;padding:13px 13px 9px}.theme-panel-head b,.vault-head b{display:block;font-size:10px;letter-spacing:.5px}.theme-panel-head small,.vault-head small{display:block;color:#777b84;font-size:8px;margin-top:4px}.theme-orb{width:26px;height:26px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff,var(--accent) 32%,transparent 70%),var(--accent);box-shadow:0 0 18px var(--glow)}
.theme-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;padding:0 10px 11px}.theme-choice{min-height:73px;padding:7px;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(0,0,0,.20);text-align:left}.theme-choice.selected{border-color:var(--accent);box-shadow:0 0 13px var(--glow),inset 0 0 15px rgba(255,255,255,.025)}.theme-preview{display:block;height:25px;border-radius:8px;background:radial-gradient(circle at 28% 25%,#fff,var(--preview) 26%,transparent 62%),linear-gradient(145deg,#101116,#050507);box-shadow:inset 0 1px rgba(255,255,255,.15),0 0 10px var(--previewGlow);margin-bottom:6px}.theme-choice b{display:block;font-size:8px}.theme-choice small{color:#6f737b;font-size:7px}
.vault-badge{font-size:8px;padding:5px 7px;border-radius:8px;color:var(--accent2);border:1px solid var(--accent);box-shadow:0 0 10px var(--glow)}.vault-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:0 10px 10px}.vault-icon{min-height:76px;border:1px solid rgba(255,255,255,.065);border-radius:12px;background:rgba(0,0,0,.18);display:grid;place-items:center;padding:5px}.vault-icon img{width:46px;height:46px;object-fit:contain;filter:drop-shadow(0 4px 5px rgba(0,0,0,.7)) drop-shadow(0 0 8px var(--glow))}.vault-icon small{font-size:7px;color:#8b8e96}.vault-link{display:block;padding:10px 12px;color:var(--accent2);font-size:8px;border-top:1px solid rgba(255,255,255,.07);text-decoration:none}
