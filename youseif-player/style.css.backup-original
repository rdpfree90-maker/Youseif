}
.drawer-close{color:#fff!important;border-color:color-mix(in srgb,var(--accent) 30%,transparent)!important}
.drawer-nav-list{display:flex;flex-direction:column;gap:6px;margin-top:18px;padding:0 8px}
.drawer-nav{
