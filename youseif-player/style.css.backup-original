.visual:before,
.visual:after {
  transform: rotate(-6deg) !important;
}

/* Ensure nav doesn't inherit perspective */
.nav {
  perspective: none !important;
}

/* ===== STRONG FIX: Kill all downward / slant tilt in player ===== */

/* Visual rings: perfectly horizontal, no rotation */
.visual:before,
.visual:after {
  transform: none !important;
  rotate: none !important;
}

/* Center play highlight shine: no tilt */
.center-play:before {
