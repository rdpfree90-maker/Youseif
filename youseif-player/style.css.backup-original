.player{background:#000;isolation:isolate}
.player-head{position:relative;z-index:4}
.player-head:after,.controls:before{content:"";position:absolute;left:12px;right:12px;height:1px;background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--accent) 18%,transparent),transparent);pointer-events:none}
