/* Inner player control language: soft oval dock + corner tools */
.visual{isolation:isolate}
.visual:global{}
.floating-tools{position:absolute;right:8px;bottom:7px;z-index:4;display:flex;align-items:center;gap:4px;padding:4px 5px;border:1px solid rgba(255,53,68,.18);border-radius:999px;background:rgba(2,2,3,.72);box-shadow:0 5px 16px rgba(0,0,0,.45),0 0 12px var(--glow);backdrop-filter:blur(8px)}
.float-tool{min-width:27px;height:25px;padding:0 7px;border:1px solid #282b31;border-radius:999px;background:linear-gradient(145deg,#111216,#060709);color:#cfd0d4;font-size:8px;font-weight:800;display:grid;place-items:center;box-shadow:inset 0 0 7px rgba(255,255,255,.018),0 0 6px var(--glow);transition:.2s}
.float-tool:hover,.float-tool:focus-visible{border-color:rgba(255,65,78,.5);color:var(--accent2);box-shadow:0 0 10px var(--glow),inset 0 0 8px var(--glow)}
.glyph-control{font-family:Arial,sans-serif;font-size:27px;font-weight:300;line-height:1;color:#eee;text-shadow:0 0 8px var(--glow)}
.glyph-control:active{color:var(--accent2)}
.player-actions button{border:1px solid transparent;border-radius:999px;transition:.2s}
.player-actions button:hover{border-color:rgba(255,55,68,.2);background:var(--glow);box-shadow:0 0 9px var(--glow)}
.controls{position:relative}
.controls:before{content:"";position:absolute;left:50%;top:-4px;width:54px;height:2px;transform:translateX(-50%);border-radius:99px;background:rgba(255,62,73,.22);box-shadow:0 0 8px var(--glow)}
@media(max-width:370px){.floating-tools{right:6px;bottom:6px}.float-tool{min-width:25px;height:23px;padding:0 6px;font-size:7px}}

