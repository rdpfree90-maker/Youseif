html[data-theme="blue"] .top-icon img{filter:hue-rotate(200deg) saturate(1.2) drop-shadow(0 0 8px var(--glow))}

.svg-ico{color:var(--accent,var(--accent2))!important}
.svg-ico svg{fill:currentColor}


/* Theme-matched nav icons */
.nav-ico{
  display:grid;place-items:center;width:26px;height:26px;
  color:rgba(255,255,255,.45);
  transition:color .2s, filter .2s, transform .15s;
}
.nav-ico svg{width:22px;height:22px;display:block;filter:drop-shadow(0 0 0 transparent)}
.nav.active .nav-ico,
.nav:hover .nav-ico{
  color:var(--accent,var(--accent2));
  filter:drop-shadow(0 0 8px var(--glow,var(--glow)));
}
.nav small{color:rgba(255,255,255,.4);font-size:9px;letter-spacing:.4px;margin-top:2px}
.nav.active small{color:rgba(255,255,255,.42)}

/* Force SVG player icons to always follow accent */
.svg-ico, .svg-ico svg{color:var(--accent,var(--accent2))!important;fill:currentColor}
.round-control .svg-ico, .float-tool .svg-ico, .ctrl-btn .svg-ico,
.player-actions .svg-ico, .copy .svg-ico, .play-btn .svg-ico{
  color:var(--accent,var(--accent2))!important;
}
.center-play .icon3d{filter:drop-shadow(0 0 12px var(--glow))!}

/* bottom nav glass follows accent */
.bottom-nav{
  border-color:color-mix(in srgb, var(--accent,var(--accent2)) 25%, transparent)!important;
  box-shadow:0 0 24px var(--glow,var(--glow)), inset 0 0 20px rgba(255,255,255,.03)!important;
}

/* Restore 3D bottom icons */
.nav-3d{
  width:28px;height:28px;object-fit:contain;display:block;
  filter:drop-shadow(0 2px 4px rgba(0,0,0,.5)) drop-shadow(0 0 6px var(--glow,var(--glow)));
  transition:filter .2s, transform .15s;
}
.nav.active .nav-3d{
  filter:drop-shadow(0 2px 6px rgba(0,0,0,.55)) drop-shadow(0 0 12px var(--glow,var(--glow))) brightness(1.08);
  transform:translateY(-1px);
}
.nav small{margin-top:3px}


/* ===== THEME BINDING: all UI follows --accent / --glow ===== */
:root{
  --accent:#ff3042;
  --accent2:#ff6570;
  --glow:rgba(255,48,66,.22);
}

/* Brand */
.brand span,.brand-name{color:var(--accent)!important;text-shadow:0 0 14px var(--glow)!important}
.menu-glyph i{background:var(--accent)!important;box-shadow:0 0 6px var(--glow)!important}

/* Top actions + play/paste */
.glass-chip,.copy.glass-chip{border-color:color-mix(in srgb,var(--accent) 40%,transparent)!important;box-shadow:0 0 14px var(--glow)!important}
.glass-chip .svg-ico,.copy .svg-ico{color:var(--accent)!important}
.glass-play,.play-btn,.play-btn.glass-play{
  border-color:color-mix(in srgb,var(--accent) 55%,transparent)!important;
  background:linear-gradient(180deg,color-mix(in srgb,var(--accent) 28%,transparent),color-mix(in srgb,var(--accent) 10%,transparent))!important;
  box-shadow:0 0 18px var(--glow)!important;
  color:#fff!important;
}
.url-box{box-shadow:inset 0 0 12px color-mix(in srgb,var(--accent) 6%,transparent)!important}

/* DETECT / LIVE */
.live-tag{border-color:var(--accent)!important;color:var(--accent2)!important;box-shadow:0 0 8px var(--glow)!important}
.live-dot{background:var(--accent)!important;box-shadow:0 0 7px var(--accent)!important}
.detect-btn,.live-tag.detect,#detectBtn{border-color:var(--accent)!important;color:var(--accent)!important}

/* Player rings + transport */
.visual:before,.visual:after{border-color:color-mix(in srgb,var(--accent) 28%,transparent)!important;box-shadow:0 0 18px var(--glow)!important}
.round-control{
  border-color:color-mix(in srgb,var(--accent) 40%,transparent)!important;
  box-shadow:0 5px 12px rgba(0,0,0,.35),0 0 10px var(--glow)!important;
}
.round-control .svg-ico,.round-control small{color:var(--accent)!important}
.center-play{
  border-color:var(--accent)!important;
  box-shadow:0 6px 15px rgba(0,0,0,.45),0 0 20px var(--glow)!important;
}
.float-tool{
  border-color:color-mix(in srgb,var(--accent) 35%,transparent)!important;
  color:var(--accent)!important;
}
.float-tool .svg-ico,.float-tool b{color:var(--accent)!important}
.float-tool:hover{border-color:var(--accent)!important;color:var(--accent2)!important;box-shadow:0 0 10px var(--glow)!important}
.glyph-control{text-shadow:0 0 8px var(--glow)!important}
.glyph-control:active{color:var(--accent2)!important}

/* Timeline + volume */
.timeline input[type=range],.volume-wrap input[type=range]{
  accent-color:var(--accent)!important;
  background:linear-gradient(90deg,var(--accent) 0 var(--progress,0%),#1c2430 var(--progress,0%))!important;
}
.timeline input::-webkit-slider-thumb,.volume-wrap input::-webkit-slider-thumb{
  background:var(--accent)!important;border-color:var(--accent2)!important;box-shadow:0 0 6px var(--glow)!important;
}
.timeline input::-moz-range-thumb,.volume-wrap input::-moz-range-thumb{
  background:var(--accent)!important;border-color:var(--accent2)!important;
}
.timeline .red,.timeline span.red{color:var(--accent2)!important}
.mini.active{border-color:var(--accent)!important;color:var(--accent2)!important;box-shadow:0 0 8px var(--glow)!important}

/* Controls */
.ctrl-btn,.player-actions button{color:var(--accent)!important}
.ctrl-btn .svg-ico,.player-actions .svg-ico{color:var(--accent)!important}
.player-actions button:hover{border-color:color-mix(in srgb,var(--accent) 30%,transparent)!important;background:color-mix(in srgb,var(--accent) 6%,transparent)!important}

/* Info cards */
.info-head{color:var(--accent)!important}
.info-head span{color:var(--accent)!important}
.info-row span:last-child{color:var(--accent2)!important}
.chart svg path,.chart svg polyline,.chart svg line{stroke:var(--accent)!important}
.chart-meta{color:var(--muted)!important}

/* Bottom nav */
.bottom-nav{
  border-color:color-mix(in srgb,var(--accent) 30%,transparent)!important;
  box-shadow:0 0 24px var(--glow), inset 0 0 20px rgba(255,255,255,.03)!important;
}
.nav.active .nav-3d,.nav.active img{
  filter:drop-shadow(0 2px 6px rgba(0,0,0,.55)) drop-shadow(0 0 12px var(--glow)) brightness(1.08)!important;
}
.nav.active small{color:rgba(255,255,255,.42)!important}
.nav.active{background:transparent!important}
.nav-ico{color:rgba(255,255,255,.45)}
.nav.active .nav-ico{color:var(--accent)!important;filter:drop-shadow(0 0 8px var(--glow))}

/* Settings */
.setting .svg-ico,.setting .icon3d{color:var(--accent)!important;filter:drop-shadow(0 0 6px var(--glow))}
.setting:active{background:color-mix(in srgb,var(--accent) 10%,transparent)!important}
.sheet-save{
  background:linear-gradient(180deg,var(--accent),color-mix(in srgb,var(--accent) 70%,#000))!important;
  box-shadow:0 0 18px var(--glow)!important;
}

/* SVG global */
.svg-ico,.svg-ico svg{color:var(--accent)!important;fill:currentColor!important}

/* App ambient glow */
.app{background:radial-gradient(900px 420px at 50% -160px,var(--glow),transparent 60%)!important}
.player{box-shadow:0 18px 38px rgba(0,0,0,.5),0 0 18px var(--glow)!important}
.controls:before{background:var(--accent)!important;box-shadow:0 0 8px var(--glow)!important}


/* ===== Icon tint: PNG icons follow theme hue ===== */
:root{
  --icon-hue: 0deg;
  --icon-sat: 1.25;
  --icon-bri: 1;
}
.icon-tint,
img.icon-tint,
.nav-3d.icon-tint,
.top-icon img.icon-tint,
.icon3d,
.nav img,
.top-icon > img,
.tiny3d img,
.center-play img,
.center-play .icon3d{
  filter:
    hue-rotate(var(--icon-hue))
    saturate(var(--icon-sat))
    brightness(var(--icon-bri))
    drop-shadow(0 2px 3px rgba(0,0,0,.55))
    drop-shadow(0 0 8px var(--glow)) !important;
  transition: filter .25s ease;
}
.nav.active .nav-3d.icon-tint,
.nav.active img{
  filter:
    hue-rotate(var(--icon-hue))
    saturate(calc(var(--icon-sat) * 1.15))
    brightness(1.08)
    drop-shadow(0 2px 4px rgba(0,0,0,.6))
    drop-shadow(0 0 14px var(--glow)) !important;
}

/* Top squares follow accent */
.top-icon,
.top-icon.glass-icon,
#menuBtn.top-icon{
  border:1px solid color-mix(in srgb, var(--accent) 35%, transparent) !important;
  background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 12%, rgba(8,12,20,.6)), rgba(8,12,20,.45)) !important;
  box-shadow: 0 0 12px var(--glow), inset 0 0 10px rgba(255,255,255,.03) !important;
  border-radius: 13px !important;
}
.top-icon:active{
  background: color-mix(in srgb, var(--accent) 18%, transparent) !important;
}
.menu-glyph i{
  background: var(--accent) !important;
  box-shadow: 0 0 6px var(--glow) !important;
}

/* CC button with icon */
#ccBtn{
  display:inline-flex; align-items:center; gap:4px;
  color: var(--accent) !important;
  border-color: color-mix(in srgb, var(--accent) 30%, transparent) !important;
}
#ccBtn .svg-ico{ width:12px; height:12px; }
#ccBtn.active{
  background: color-mix(in srgb, var(--accent) 15%, transparent) !important;
  box-shadow: 0 0 10px var(--glow) !important;
}


/* ===== v4.2.6 remaining red → accent ===== */
.count-accent, .title .count-accent{color:var(--accent)!important}
.link, .section-head .link, span.link{
  color:var(--accent)!important;
}
.chip.active, .filter-chip.active, .chips .active,
button.chip.active, .category-chip.active,
.search .chip.active, [data-chip].active{
  border-color:var(--accent)!important;
  color:var(--accent)!important;
  box-shadow:0 0 10px var(--glow)!important;
  background:color-mix(in srgb,var(--accent) 12%,transparent)!important;
}
/* channels filter ALL etc - generic active pill */
.page button.active, .filters button.active, .chip-row button.active,
.tag.active, .pill.active{
  border-color:var(--accent)!important;
  color:var(--accent)!important;
}

/* Download progress bar */
.download-card progress, .download-card .progress, .progress-bar,
.download-card .bar, .dl-progress, .progress > i, .progress-fill{
