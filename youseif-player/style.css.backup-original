}
.drawer-ico{
  width:28px;height:28px;object-fit:contain;
  filter:hue-rotate(var(--icon-hue)) saturate(var(--icon-sat)) drop-shadow(0 0 8px var(--glow))!important;
}

/* Force ALL bottom nav icons to always include hue - override any old rules */
.bottom-nav .nav img,
.bottom-nav .nav-3d,
.bottom-nav .icon-tint{
  filter:hue-rotate(var(--icon-hue)) saturate(var(--icon-sat)) brightness(var(--icon-bri))
    drop-shadow(0 2px 3px rgba(0,0,0,.55)) drop-shadow(0 0 8px var(--glow))!important;
}
.bottom-nav .nav.active img,
.bottom-nav .nav.active .nav-3d{
  filter:hue-rotate(var(--icon-hue)) saturate(calc(var(--icon-sat)*1.2)) brightness(1.1)
    drop-shadow(0 2px 4px rgba(0,0,0,.6)) drop-shadow(0 0 14px var(--glow))!important;
}

/* Top icons always tinted */
.top-icon img{
  filter:hue-rotate(var(--icon-hue)) saturate(var(--icon-sat))
    drop-shadow(0 2px 3px rgba(0,0,0,.55)) drop-shadow(0 0 6px var(--glow))!important;
}

/* Category icons on films/channels */
.category .icon3d, .category img{
  filter:hue-rotate(var(--icon-hue)) saturate(var(--icon-sat)) drop-shadow(0 0 8px var(--glow))!important;
}

.chip{
